package Day_2_assignment;

import java.time.Duration;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
public class Testcase1 
{
	public static void main(String[] args) throws InterruptedException 
	{		
		//Launch the browser
		WebDriver driver=new ChromeDriver();
		
		//Maximize the browser window
		driver.manage().window().maximize();
		
		//apply implicit wait
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(20));
		
		//Navigate to facebook application
		driver.get("https://www.facebook.com");
		Thread.sleep(2000);
		
		//click on create new account button
		WebElement button=driver.findElement(By.xpath("(//span[@class='x1lliihq x193iq5w x6ikm8r x10wlt62 xlyipyv xuxw1ft'])[3]"));
		button.click();
		Thread.sleep(2000);
		
		//Locating firstname and surname elements
		WebElement firstname=driver.findElement(By.xpath("//input[@id='_R_1cl2p4jikacppb6amH1_']"));
		WebElement surname=driver.findElement(By.xpath("//input[@id='_R_1kl2p4jikacppb6amH1_']"));

		//get the location of both elements
		System.out.println(firstname.getLocation());
		System.out.println(surname.getLocation());
		
		//verify that firstname and surname textfields aligned in same line or not		
		int fnY=firstname.getLocation().getY();
		int snY=surname.getLocation().getY();
		if(fnY==snY) 
		{
			System.out.println("Firstname and Surname textfields are aligned in the same line");
		}
		else
		{
			System.out.println("Firstname and Surname textfields are not aligned in the same line");
		}		
		Thread.sleep(2000);		
		//close the browser
		driver.quit();
	}
}

